<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承 Spring Boot 父 POM，统一管理依赖版本 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.15</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>comment-analysis-system</artifactId>
    <version>1.0.0</version>
    <name>comment-analysis-system</name>
    <description>中文评论智能分析系统 - 后端服务</description>

    <properties>
        <java.version>1.8</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- MyBatis-Plus：3.5.3.1 为适配 Spring Boot 2.7 的稳定版本 -->
        <mybatis-plus.version>3.5.3.1</mybatis-plus.version>
        <easyexcel.version>3.3.4</easyexcel.version>
        <mysql.version>8.0.33</mysql.version>
        <!-- 覆盖父 POM 的 Lombok 版本：1.18.34 起支持 JDK 21+，保证注解处理在较新 JDK 下可用 -->
        <lombok.version>1.18.34</lombok.version>
        <!-- DJL（Deep Java Library）核心与 PyTorch 引擎版本 -->
        <djl.version>0.38.0</djl.version>
        <!-- PyTorch 本地库版本，与 pytorch-engine 0.38.0 兼容（见 DJL 官方版本对照表） -->
        <pytorch.version>2.7.1</pytorch.version>
        <!-- 本地库平台分类器：默认 Windows，Linux/macOS 通过 Maven profile 覆盖 -->
        <pytorch.native.classifier>win-x86_64</pytorch.native.classifier>
    </properties>

    <dependencies>
        <!-- Web 能力：内嵌 Tomcat + Spring MVC -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 参数校验（供 @Valid 与全局异常处理器的参数校验分支使用） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- MyBatis-Plus：增强版 MyBatis，提供 BaseMapper 通用 CRUD -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-boot-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <!-- MySQL 8.0 驱动 -->
        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
            <version>${mysql.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Lombok：编译期生成 getter/setter/构造器，简化实体类 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <optional>true</optional>
        </dependency>

        <!-- EasyExcel：Excel/CSV 读写，用于解析评论文件与导出分析结果 -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>easyexcel</artifactId>
            <version>${easyexcel.version}</version>
        </dependency>

        <!-- jsoup：网页抓取与正文提取（链接智能输入） -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>1.17.2</version>
        </dependency>

        <!-- 密码哈希（BCrypt），仅引入 crypto 模块，不启用完整 Spring Security 过滤链 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- 健康检查与运行指标 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ==================== DJL：Java 端加载 PyTorch TorchScript 模型 ==================== -->

        <!-- 版本对齐：ai.djl:api 传递引入 commons-compress 1.27.1，该版本依赖 commons-io 2.16+ 的
             build 包，而项目中经 EasyExcel→POI 4.1.2 传递的 commons-io 为 2.11.0，组合后导出 xlsx
             会在收尾阶段抛 NoClassDefFoundError: ZipFile$Builder（响应头已下发，文件为 0 字节）。
             此处显式降级为 POI 4.1.2 兼容的 1.25.0，消除该冲突。 -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-compress</artifactId>
            <version>1.25.0</version>
        </dependency>

        <!-- DJL 核心 API：引擎无关的推理接口（Criteria / Predictor / NDArray 等） -->
        <dependency>
            <groupId>ai.djl</groupId>
            <artifactId>api</artifactId>
            <version>${djl.version}</version>
        </dependency>

        <!-- DJL PyTorch 引擎适配层：负责调用 libtorch 执行推理 -->
        <dependency>
            <groupId>ai.djl.pytorch</groupId>
            <artifactId>pytorch-engine</artifactId>
            <version>${djl.version}</version>
        </dependency>

        <!-- PyTorch CPU 本地库（libtorch），随应用打包，避免运行时联网下载。
             当前 classifier 为 Windows 64 位；部署到 Linux 请改为 linux-x86_64，
             macOS(Apple Silicon) 改为 osx-aarch64。 -->
        <dependency>
            <groupId>ai.djl.pytorch</groupId>
            <artifactId>pytorch-native-cpu</artifactId>
            <version>${pytorch.version}</version>
            <classifier>${pytorch.native.classifier}</classifier>
            <scope>runtime</scope>
        </dependency>

        <!-- 测试依赖 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 显式声明 Lombok 注解处理器，保证在 JDK 21+ 下注解处理正常执行 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- 打包为可执行 JAR -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!-- 跨平台打包：mvn -Plinux package / mvn -Pmacos package 会自动切换 PyTorch 本地库 -->
    <profiles>
        <profile>
            <id>linux</id>
            <properties>
                <pytorch.native.classifier>linux-x86_64</pytorch.native.classifier>
            </properties>
        </profile>
        <profile>
            <id>macos</id>
            <properties>
                <pytorch.native.classifier>osx-aarch64</pytorch.native.classifier>
            </properties>
        </profile>
    </profiles>
</project>
